FROM owasp/modsecurity-crs:nginx-alpine

# Copy the nginx configuration file
COPY nginx.conf /etc/nginx/templates/conf.d/default.conf.template

# Health check: verifies that Nginx can serve HTTPS requests on the dedicated
# health endpoint.
# Flags:
#   -f: fail on HTTP errors (4xx, 5xx)
#   -k: skip SSL verification for self-signed certificate
# Options:
#   --interval=10s:		check every 10 seconds
#   --timeout=5s:		fail check if response exceeds 5 seconds
#   --start-period=15s:	grace period after container start
#   --retries=3:		mark unhealthy after 3 consecutive failures
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fk https://localhost:8443/healthz || exit 1

EXPOSE 8443 8080

# Background watcher for ACME certificate renewal markers on the shared volume.
COPY --chmod=755 cert-reload-watcher.sh /docker-entrypoint.d/99-cert-reload-watcher.sh

# Keep "nginx" as $1 so /docker-entrypoint.sh runs all /docker-entrypoint.d/* hooks.
CMD ["nginx", "-g", "daemon off;"]
