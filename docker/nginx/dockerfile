# Base image: official Nginx stable image based on Alpine Linux
FROM nginx:stable-alpine

# Remove default configuration files
RUN rm -rf /etc/nginx/conf.d

# Copy the configuration file overwriting the default one
COPY nginx.conf /etc/nginx/nginx.conf

# Install OpenSSL (for certificate handling), curl (for healthcheck and acme.sh),
# acme.sh (for Let's Encrypt TLS certificate automation via DNS-01 challenge),
# socat (network helper utility for acme.sh), and ca-certificates.
# The --no-cache flag keeps the image minimal by not saving package manager cache.
RUN apk add --no-cache openssl curl acme.sh socat ca-certificates

# Copy the entrypoint script and make it executable
COPY nginx_entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/nginx_entrypoint.sh

# Health check: verifies that Nginx can serve HTTPS requests on the dedicated
# health endpoint.
# Flags:
#   -f: fail on HTTP errors (4xx, 5xx)
#   -k: skip SSL verification for self-signed certificate
# Options:
#   --interval=10s:		check every 10 seconds
#   --timeout=5s:		fail check if response exceeds 5 seconds
#   --start-period=5s:	grace period after container start
#   --retries=3:		mark unhealthy after 3 consecutive failures
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -fk https://localhost/healthz || exit 1

# Expose HTTPS port
EXPOSE 443

# Define the entrypoint script
ENTRYPOINT ["nginx_entrypoint.sh"]

# Define the default command: starts Nginx in foreground.
# The flag -g passes global directives to Nginx: 'daemon off;' is crucial in
# Docker so the main process stays in foreground (PID 1).
CMD ["nginx", "-g", "daemon off;"]