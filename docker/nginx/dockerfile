FROM nginx:stable-alpine

#RUN rm /etc/nginx/conf.d/default.conf
#COPY ./nginx.conf /etc/nginx/conf.d/

# Copy the configuration file overwriting the default one.
COPY nginx.conf /etc/nginx/nginx.conf

# Update packages and install OpenSSL, and curl. The --no-cache flag is
# needed to make the image smaller by not saving the package manager cache.
# Openssl is used to generate a self-signed certificate for the app.
# Curl is used for healthcheck to test HTTPS endpoint availability.
# Netcat is used for ...? LUIS EXPLAIN IT TO ME !!!!!!!!
RUN apk update && apk add --no-cache openssl curl netcat-openbsd

# Copy the entrypoint script and make it executable
COPY nginx_entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/nginx_entrypoint.sh

# Create self-signed certificate
RUN mkdir -p /etc/nginx/ssl
RUN openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
  -keyout /etc/nginx/ssl/transcendence.key \
  -out /etc/nginx/ssl/transcendence.crt \
  -subj "/C=IT/ST=Italy/L=Italy/O=Dev/CN=localhost" \
  -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
# COPY ssl/transcendence.crt /etc/nginx/ssl/transcendence.crt
# COPY ssl/transcendence.key /etc/nginx/ssl/transcendence.key


# Disabilita i log di [notice] all'avvio
# RUN ln -sf /dev/null /var/log/nginx/error.log




# Health check: verifies that Nginx can serve HTTPS requests.
# Uses curl to test the actual HTTPS endpoint.
# Flags:
#   -f: fail on HTTP errors (4xx, 5xx)
#   -k: insecure, skip SSL certificate verification (self-signed cert)
# Options:
#   --interval=30s: check every 30 seconds  
#   --timeout=5s: fail the check if it takes longer than 5s
#   --start-period=10s: grace period after container start
#   --retries=3: mark unhealthy after 3 consecutive failures
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
CMD curl -fk https://localhost || exit 1

# Expose port 443.
EXPOSE 443


ENTRYPOINT ["nginx_entrypoint.sh"]

# Use SIGQUIT so Nginx shuts down gracefully (finishes active requests)
# instead of the default SIGTERM.
# STOPSIGNAL SIGQUIT
# The nginx Docker image already did this!

# Define the default command: starts Nginx in foreground.
# The flag -g is used to pass to Nginx a global directive instead of putting
# it in the config file.
# The directive 'daemon off;' starts Nginx in the foreground: this is crucial
# for Docker because the main container process must stay in the foreground;
# if Nginx daemonizes (runs in the background), the container exits.
# The directive error_log is 
CMD ["nginx", "-g", "daemon off; error_log /dev/stdout warn;"]
