# Application version
APP_VERSION=<1.0>

# Reverse proxy domain name (for TLS certificate CN/SAN)
# In development: localhost
# In production: your registered domain name (e.g. wecook.example.com)
DOMAIN_NAME=<localhost>

# Environment mode:
# - false (default): Development mode using fast, local self-signed SSL
#   certificates.
# - true: Production mode using Let's Encrypt certificates generated via
#   acme.sh DNS-01 challenge.
PRODUCTION_FLAG=<false>

# Vault flag (read by the Makefile, the entrypoints and compose):
# - true (default): secrets are fetched from HashiCorp Vault at startup.
#   Run ./vault-setup.sh once per machine and ./unseal.sh after every restart.
# - false: development mode. Vault is NOT used and secrets are read from
#   this file (fill in the 'Development-only secrets' section at the bottom).
USE_VAULT=true

# WAF paranoia level (ModSecurity / OWASP CRS), from 1 (lenient) to 4 (strictest).
# Raise it (2 or 3) only after testing login, registration, 2FA and uploads.
WAF_PARANOIA=3

# Infomaniak API Token. Required when PRODUCTION_FLAG=true. Must be created
# with 'domain' scope (dns:read, dns:write, domain:read permissions).
# Leave it empty in development environment.
# INFOMANIAK_API_TOKEN=<your_infomaniak_api_token>

# Let's Encrypt Account Email. Optional contact email for Let's Encrypt
# registration and certificate expiry notifications.
ACME_EMAIL=<your_email@example.com>

# Let's Encrypt Staging Environment:
# - false (default): Uses Let's Encrypt production servers to issue valid,
#   trusted certificates.
# - true: Uses Let's Encrypt staging servers to test Infomaniak DNS-01
#   challenge without hitting rate limits.
ACME_STAGING=<false>

# PostgreSQL database configuration
POSTGRES_USER=<postgres>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<recipe_platform>
DATABASE_URL=postgresql://<postgres>:<postgres_password>@database:5432/<recipe_platform>?schema=public

# Vault IDs
ACME_VAULT_ROLE_ID=<acme_role_id>
ACME_VAULT_SECRET_ID=<acme_secret_id>
DATABASE_VAULT_ROLE_ID=<database_role_id>
DATABASE_VAULT_SECRET_ID=<database_secret_id>
BACKEND_VAULT_ROLE_ID=<backend_role_id>
BACKEND_VAULT_SECRET_ID=<backend_secret_id>

# Security Secrets
# Generate random 32-byte hex strings using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_AUTH=<two_factor_auth_secret>

# Translation service configuration (Internal Docker URL)
LIBRETRANSLATE_URL=http://libretranslate:5000

# Absolute directory used for uploaded media inside the backend container
UPLOADS_DIR=/usr/src/app/uploads
