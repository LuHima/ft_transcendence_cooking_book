# Application version
APP_VERSION=<1.0>

# Reverse proxy domain name (for TLS certificate CN/SAN)
# In development: localhost
# In production: your registered domain name (e.g. wecook.example.com)
DOMAIN_NAME=<localhost>

# Environment mode:
# - false (default): Development mode using fast, local self-signed SSL
#   certificates.
# - true: Production mode using Let's Encrypt certificates generated via
#   acme.sh DNS-01 challenge.
PRODUCTION_FLAG=<false>

# Infomaniak API Token. Required when PRODUCTION_FLAG=true. Must be created
# with 'domain' scope (dns:read, dns:write, domain:read permissions).
INFOMANIAK_API_TOKEN=<your_infomaniak_api_token>

# Let's Encrypt Account Email. Optional contact email for Let's Encrypt
# registration and certificate expiry notifications.
ACME_EMAIL=<your_email@example.com>

# Let's Encrypt Staging Environment:
# - false (default): Uses Let's Encrypt production servers to issue valid,
#   trusted certificates.
# - true: Uses Let's Encrypt staging servers to test Infomaniak DNS-01
#   challenge without hitting rate limits.
ACME_STAGING=<false>

# PostgreSQL database configuration
POSTGRES_USER=<postgres>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<recipe_platform>
DATABASE_URL=postgresql://<postgres>:<postgres_password>@database:5432/<recipe_platform>?schema=public

# Security Secrets
# Generate random 32-byte hex strings using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<jwt_secret>
JWT_REFRESH_SECRET=<jwt_refresh_secret>
COOKIE_SECRET=<cookie_secret>

# Translation service configuration (Internal Docker URL)
LIBRETRANSLATE_URL=http://libretranslate:5000
