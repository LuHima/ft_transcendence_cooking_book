  "info": {
    "title": "WeCook API",
    "description": "Private API documentation for frontend",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "SignInUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 9
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignUpUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 9,
            "maxLength": 72,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[\\d\\W_]).+$"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "ConfirmPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "TwoFactorAuth": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 6,
            "maxLength": 6
          },
          "tempToken": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "tempToken"
        ]
      },
      "TwoFactorCode": {
        "type": "object",
        "properties": {}
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string",
            "maxLength": 100
          },
          "last_name": {
            "type": "string",
            "maxLength": 100
          },
          "birth_date": {
            "type": "object"
          },
          "phone": {
            "type": "string",
            "maxLength": 30
          },
          "address": {
            "type": "string",
            "maxLength": 255
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "postal_code": {
            "type": "string",
            "maxLength": 10
          }
        }
      },
      "CreateRecipeStepDto": {
        "type": "object",
        "properties": {
          "step_number": {
            "type": "number",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "step_number",
          "description"
        ]
      },
      "CreateRecipeIngredientDto": {
        "type": "object",
        "properties": {
          "ingredient_id": {
            "type": "number"
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "ml",
              "cl",
              "l",
              "oz",
              "lb",
              "fl_oz",
              "cup",
              "tbsp",
              "tsp",
              "piece",
              "pinch"
            ]
          },
          "notes": {
            "type": "object"
          }
        },
        "required": [
          "ingredient_id",
          "quantity",
          "unit"
        ]
      },
      "CreateRecipeDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "preservation": {
            "type": "string"
          },
          "tips": {
            "type": "string"
          },
          "course": {
            "type": "string",
            "enum": [
              "appetizer",
              "first_course",
              "main_course",
              "dessert",
              "side_dish",
              "drink",
              "snack"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "prep_time": {
            "type": "number",
            "minimum": 0
          },
          "cook_time": {
            "type": "number",
            "minimum": 0
          },
          "servings": {
            "type": "number",
            "minimum": 1
          },
          "source_lang": {
            "type": "string",
            "enum": [
              "it",
              "en",
              "fr"
            ]
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateRecipeStepDto"
            }
          },
          "ingredients": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateRecipeIngredientDto"
            }
          },
          "tag_ids": {
            "type": "array",
