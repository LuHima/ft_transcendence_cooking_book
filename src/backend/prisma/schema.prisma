generator client {
	provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum OwnerType {
  user
  platform
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum MediaType {
  image
  video
}

enum RecipeDifficulty {
  easy
  medium
  hard
}

enum TranslationStatus {
  completed
  failed
}

enum TranslationSource {
  author_original
  machine
  manual
}

enum Course {
  appetizer
  first_course
  main_course
  dessert
  side_dish
  drink
  snack
}

enum UnitOfMeasure {
  g
  kg
  ml
  cl
  l
  oz
  lb
  fl_oz
  cup
  tbsp
  tsp
  piece
  pinch
}

enum IngredientCategory {
  produce
  dairy_eggs
  meat_poultry
  seafood
  bakery_grains
  pantry_spices
  legumes_nuts
  beverages_liquids
  other
}

enum Role {
  admin
  moderator
  user
}

enum UserStatus {
  active
  disabled
  banned
}

enum NotificationSubject {
  recipe
  comment
  user
}

enum NotificationAction {
  like
  comment
  friend_request
  friend_accept
  post
  delete
  update
}

enum FriendshipStatus {
  pending
  accepted
  rejected
  none
}

enum ReportSubject {
  recipe
  comment
  user
}

enum ReportReason {
  spam_scam
  harassment_bullying
  hate_speech
  sexual_content
  violence_threats
  copyright_infringement
  impersonation_misinformation
  other
}

enum ReportStatus {
  pending
  reviewed
  dismissed
  action_taken
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(30)
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  avatar_url    String?   @db.VarChar(255)
  bio           String?   @db.VarChar(500)
  first_name    String?   @db.VarChar(100)
  last_name     String?   @db.VarChar(100)
  birth_date    DateTime? @db.Date
  phone         String?   @db.VarChar(30)
  address       String?   @db.VarChar(255)
  city          String?   @db.VarChar(100)
  postal_code   String?   @db.VarChar(10)
  status 		UserStatus @default(active)
  banned_until  DateTime?
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  role          Role    @default(user)
  two_factor 	String? @db.VarChar(255)
  is_two_factor_enabled Boolean  @default(false)
  jwt_sessions  JwtSession[]
  
  recipes        Recipe[]
  comments       Comment[]
  likes          Like[]

  notifications_received Notification[] @relation("NotificationRecipient")
  notifications_sent     Notification[] @relation("NotificationActor")

  friendships_sent     Friendship[] @relation("FriendshipRequester")
  friendships_received Friendship[] @relation("FriendshipAddressee")

  blocks_sent          UserBlock[]  @relation("BlocksSent")
  blocks_received      UserBlock[]  @relation("BlocksReceived")
  reports_submitted    Report[]     @relation("ReportsSubmitted")

  ban_history          BanHistory[] @relation("UserBanHistory")
  bans_issued          BanHistory[] @relation("StaffIssuedBans")
  unbans_issued        BanHistory[] @relation("StaffUnbans")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// RECIPES
// ─────────────────────────────────────────────────────────────────────────────

model Recipe {
  id                 Int                @id @default(autoincrement())
  user_id            Int?
  owner_type         OwnerType          @default(user)
  is_active          Boolean            @default(true)
  course             Course             @default(main_course)
  difficulty         RecipeDifficulty   @default(easy)
  prep_time          Int                @default(0)
  cook_time          Int                @default(0)
  total_time         Int                @default(0)
  servings           Int                @default(1)
  source_lang        String             @default("en") @db.VarChar(5)
  translation_status TranslationStatus  @default(completed)
  cover_image_url    String?            @db.VarChar(500)
  video_url          String?            @db.VarChar(500)
  created_at         DateTime           @default(now())
  updated_at         DateTime?          @updatedAt

  user               User?              @relation(fields: [user_id], references: [id])
  translations       RecipeTranslation[]
  steps              RecipeStep[]
  recipe_ingredients RecipeIngredient[]
  recipe_tags        RecipeTag[]
  comments           Comment[]
  likes              Like[]
  recipe_media       RecipeMedia[]

  @@map("recipes")
}

model RecipeTranslation {
  recipe_id          Int
  locale             String            @db.VarChar(5)
  title              String            @db.VarChar(255)
  description        String
  preservation       String?
  tips               String?
  translation_source TranslationSource @default(machine)

  recipe       Recipe  @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@id([recipe_id, locale])
  @@index([locale, title])
  @@map("recipe_translations")
}

model RecipeStep {
  id           Int                     @id @default(autoincrement())
  recipe_id    Int
  step_number  Int
  duration     Int?
  image_url    String?                 @db.VarChar(500)

  recipe       Recipe                  @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  translations RecipeStepTranslation[]

  @@unique([recipe_id, step_number])
  @@map("recipe_steps")
}

model RecipeStepTranslation {
  step_id      Int
  locale       String  @db.VarChar(5)
  title        String? @db.VarChar(255)
  description  String

  step         RecipeStep @relation(fields: [step_id], references: [id], onDelete: Cascade)

  @@id([step_id, locale])
  @@map("recipe_step_translations")
}

model RecipeTag {
  recipe_id    Int
  tag_id       Int

  recipe       Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  tag          Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([recipe_id, tag_id])
  @@map("recipe_tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// INGREDIENTS
// ─────────────────────────────────────────────────────────────────────────────

model Ingredient {
  id                 Int                    @id @default(autoincrement())
  slug               String                 @unique @db.VarChar(100)
  category           IngredientCategory

  translations       IngredientTranslation[]
  recipe_ingredients RecipeIngredient[]

  @@map("ingredients")
}

model IngredientTranslation {
  ingredient_id Int
  locale        String @db.VarChar(5)
  name          String @db.VarChar(100)

  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@id([ingredient_id, locale])
  @@index([locale, name])
  @@map("ingredient_translations")
}

model Tag {
  id           Int              @id @default(autoincrement())
  slug         String           @unique @db.VarChar(50)

  translations TagTranslation[]
  recipe_tags  RecipeTag[]

  @@map("tags")
}

model TagTranslation {
  tag_id Int
  locale String @db.VarChar(5)
  name   String @db.VarChar(100)

  tag    Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([tag_id, locale])
  @@index([locale, name])
  @@map("tag_translations")
}

model RecipeIngredient {
  recipe_id     Int
  ingredient_id Int
  quantity      Decimal       @db.Decimal(10, 2)
  unit          UnitOfMeasure
  notes         Json?

  recipe     Recipe     @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id])

  @@id([recipe_id, ingredient_id])
  @@map("recipe_ingredients")
}

// ─────────────────────────────────────────────────────────────────────────────
// FRIENDSHIPS
// ─────────────────────────────────────────────────────────────────────────────

model Friendship {
  id           Int              @id @default(autoincrement())
  requester_id Int
  addressee_id Int
  status       FriendshipStatus @default(pending)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  requester    User             @relation("FriendshipRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee    User             @relation("FriendshipAddressee", fields: [addressee_id], references: [id], onDelete: Cascade)

  @@unique([requester_id, addressee_id])
  @@index([addressee_id, status])
  @@index([requester_id, status])
  @@map("friendships")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMENTS (struttura ad albero: parent_id per le risposte)
// ─────────────────────────────────────────────────────────────────────────────

model Comment {
  id         Int       @id @default(autoincrement())
  recipe_id  Int
  user_id    Int?
  parent_id  Int?
  content    String
  is_active  Boolean   @default(true)
  is_edited  Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  recipe  Recipe    @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [user_id], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

// ─────────────────────────────────────────────────────────────────────────────
// LIKES
// ─────────────────────────────────────────────────────────────────────────────

model Like {
  user_id    Int
  recipe_id  Int
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@id([user_id, recipe_id])
  @@map("likes")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int              // destinatario (autore della ricetta)
  actor_id   Int              // chi ha messo like / commentato

  subject    NotificationSubject
  action     NotificationAction

  target_id	Int?

  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())


  user   User   @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  actor  User   @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// RECIPE MEDIA
// ─────────────────────────────────────────────────────────────────────────────

model RecipeMedia {
  id         Int       @id @default(autoincrement())
  recipe_id  Int
  url        String    @db.VarChar(500)
  media_type MediaType
  order      Int       @default(0)
  created_at DateTime  @default(now())

  recipe Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@map("recipe_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// TOKEN JWT
// ─────────────────────────────────────────────────────────────────────────────

model JwtSession {
  id_session      Int      @id @default(autoincrement())
  id_user         Int
  hashed_jwt_token String  @db.VarChar(255)
  expire_time_jwt DateTime

  user User @relation(fields: [id_user], references: [id], onDelete: Cascade)

  @@map("jwt_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER BLOCKS
// ─────────────────────────────────────────────────────────────────────────────

model UserBlock {
  id         Int      @id @default(autoincrement())
  blocker_id Int
  blocked_id Int
  created_at DateTime @default(now())

  blocker    User     @relation("BlocksSent", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked    User     @relation("BlocksReceived", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
  @@map("user_blocks")
}

// ─────────────────────────────────────────────────────────────────────────────
// REPORTS
// ─────────────────────────────────────────────────────────────────────────────

model Report {
  id                     Int           @id @default(autoincrement())
  reporter_id            Int
  subject                ReportSubject
  target_id              Int
  reason                 ReportReason
  description            String?       @db.VarChar(1000)
  status                 ReportStatus  @default(pending)
  resolution_reason      ReportReason?
  resolution_description String?       @db.VarChar(1000)
  resolution_notes       String?       @db.VarChar(1000)
  resolved_by_id         Int?
  resolved_at            DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  reporter               User          @relation("ReportsSubmitted", fields: [reporter_id], references: [id], onDelete: Cascade)
  ban_history            BanHistory[]

  @@index([status, created_at])
  @@index([subject, target_id])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// BAN HISTORY
// ─────────────────────────────────────────────────────────────────────────────

model BanHistory {
  id             String       @id @default(uuid())
  user_id        Int
  user           User         @relation("UserBanHistory", fields: [user_id], references: [id], onDelete: Cascade)
  banned_by_id   Int
  banned_by      User         @relation("StaffIssuedBans", fields: [banned_by_id], references: [id])
  report_id      Int?
  report         Report?      @relation(fields: [report_id], references: [id], onDelete: SetNull)
  reason         ReportReason
  description    String?      @db.VarChar(1000)
  duration_days  Int?
  is_permanent   Boolean      @default(false)
  banned_at      DateTime     @default(now())
  expires_at     DateTime?
  unbanned_at    DateTime?
  unbanned_by_id Int?
  unbanned_by    User?        @relation("StaffUnbans", fields: [unbanned_by_id], references: [id])
  unban_reason   String?      @db.VarChar(1000)

  @@index([user_id])
  @@index([banned_at])
  @@map("ban_history")
}

