generator client {
	provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum OwnerType {
  user
  platform
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum MediaType {
  image
  video
}

enum RecipeDifficulty {
  easy
  medium
  hard
}

enum Course {
  appetizer
  first_course
  main_course
  dessert
  side_dish
  drink
  snack
}

enum UnitOfMeasure {
  g
  kg
  ml
  cl
  l
  oz
  lb
  fl_oz
  cup
  tbsp
  tsp
  piece
  pinch
}

enum IngredientCategory {
  produce
  dairy_eggs
  meat_poultry
  seafood
  bakery_grains
  pantry_spices
  legumes_nuts
  beverages_liquids
  other
}

enum Role {
  admin
  user
}

enum NotificationType {
  like
  comment
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(30)
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  avatar_url    String?   @db.VarChar(255)
  first_name    String?   @db.VarChar(100)
  last_name     String?   @db.VarChar(100)
  birth_date    DateTime? @db.Date
  phone         String?   @db.VarChar(30)
  address       String?   @db.VarChar(255)
  city          String?   @db.VarChar(100)
  postal_code   String?   @db.VarChar(10)
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  role          Role    @default(user)
  jwt_sessions  JwtSession[]
  
  recipes        Recipe[]
  comments       Comment[]
  likes          Like[]
  meal_plans     MealPlan[]

  notifications_received Notification[] @relation("NotificationRecipient")
  notifications_sent     Notification[] @relation("NotificationActor")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// RECIPES
// ─────────────────────────────────────────────────────────────────────────────

model Recipe {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  owner_type   OwnerType @default(user)
  title        String    @db.VarChar(255)
  description  String?
  instructions String?
  prep_time    Int?
  difficulty   RecipeDifficulty @default(easy)
  created_at   DateTime  @default(now())

  user               User?              @relation(fields: [user_id], references: [id])
  recipe_ingredients RecipeIngredient[]
  comments           Comment[]
  likes              Like[]
  meal_plan_recipes  MealPlanRecipe[]
  recipe_media       RecipeMedia[]
  notifications 	 Notification[]

  @@map("recipes")
}

// ─────────────────────────────────────────────────────────────────────────────
// INGREDIENTS
// ─────────────────────────────────────────────────────────────────────────────

model Ingredient {
  id                 Int                    @id @default(autoincrement())
  slug               String                 @unique @db.VarChar(100)
  category           IngredientCategory

  translations       IngredientTranslation[]
  recipe_ingredients RecipeIngredient[]

  @@map("ingredients")
}

model IngredientTranslation {
  ingredient_id Int
  locale        String @db.VarChar(5)
  name          String @db.VarChar(100)

  ingredient    Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@id([ingredient_id, locale])
  @@index([locale, name])
  @@map("ingredient_translations")
}

model Tag {
  id           Int              @id @default(autoincrement())
  slug         String           @unique @db.VarChar(50)

  translations TagTranslation[]

  @@map("tags")
}

model TagTranslation {
  tag_id Int
  locale String @db.VarChar(5)
  name   String @db.VarChar(100)

  tag    Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([tag_id, locale])
  @@index([locale, name])
  @@map("tag_translations")
}

model RecipeIngredient {
  recipe_id     Int
  ingredient_id Int
  quantity      Decimal       @db.Decimal(10, 2)
  unit          UnitOfMeasure
  notes         Json?

  recipe     Recipe     @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id])

  @@id([recipe_id, ingredient_id])
  @@map("recipe_ingredients")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMENTS (struttura ad albero: parent_id per le risposte)
// ─────────────────────────────────────────────────────────────────────────────

model Comment {
  id         Int      @id @default(autoincrement())
  recipe_id  Int
  user_id    Int?
  parent_id  Int?
  content    String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  recipe  Recipe    @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [user_id], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parent_id], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

// ─────────────────────────────────────────────────────────────────────────────
// LIKES
// ─────────────────────────────────────────────────────────────────────────────

model Like {
  user_id    Int
  recipe_id  Int
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@id([user_id, recipe_id])
  @@map("likes")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int              // destinatario (autore della ricetta)
  actor_id   Int              // chi ha messo like / commentato
  recipe_id  Int
  type       NotificationType
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  user   User   @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  actor  User   @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEAL PLANS
// ─────────────────────────────────────────────────────────────────────────────

model MealPlan {
  id         Int      @id @default(autoincrement())
  user_id    Int
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  created_at DateTime @default(now())

  user              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  meal_plan_recipes MealPlanRecipe[]

  @@map("meal_plans")
}

model MealPlanRecipe {
  meal_plan_id Int
  recipe_id    Int
  planned_date DateTime @db.Date
  meal_type    MealType

  meal_plan MealPlan @relation(fields: [meal_plan_id], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@id([meal_plan_id, recipe_id, planned_date])
  @@map("meal_plan_recipes")
}

// ─────────────────────────────────────────────────────────────────────────────
// RECIPE MEDIA
// ─────────────────────────────────────────────────────────────────────────────

model RecipeMedia {
  id         Int       @id @default(autoincrement())
  recipe_id  Int
  url        String    @db.VarChar(500)
  media_type MediaType
  order      Int       @default(0)
  created_at DateTime  @default(now())

  recipe Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@map("recipe_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// TOKEN JWT
// ─────────────────────────────────────────────────────────────────────────────

model JwtSession {
  id_session      Int      @id @default(autoincrement())
  id_user         Int
  hashed_jwt_token String  @db.VarChar(255)
  expire_time_jwt DateTime

  user User @relation(fields: [id_user], references: [id], onDelete: Cascade)

  @@map("jwt_sessions")
}